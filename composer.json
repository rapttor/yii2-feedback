{
    "name": "rapttor/yii2-feedback",
    "description": "Yii2 extension: a feedback widget (closable floating button, menu trigger) with consented page snapshots, 22 languages, and a small admin inbox. Stores feedback in one shared table.",
    "type": "yii2-extension",
    "keywords": [
        "yii2",
        "yii2-extension",
        "feedback",
        "beta",
        "bug-report",
        "widget"
    ],
    "homepage": "https://github.com/rapttor/yii2-feedback",
    "license": "MIT",
    "authors": [
        {
            "name": "Rapttor",
            "homepage": "https://rapttor.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "yiisoft/yii2": "~2.0.54",
        "ext-mbstring": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "yiisoft/yii2-symfonymailer": "~2.0.3"
    },
    "autoload": {
        "psr-4": {
            "rapttor\\yii2feedback\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "rapttor\\yii2feedback\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "bootstrap": "rapttor\\yii2feedback\\Bootstrap"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
